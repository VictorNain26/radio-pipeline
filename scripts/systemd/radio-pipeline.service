[Unit]
Description=AubeSonore Radio Pipeline
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PIPELINE_DIR@
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@PIPELINE_DIR@/run.sh
StandardOutput=append:@PIPELINE_DIR@/cron.log
StandardError=append:@PIPELINE_DIR@/cron.log

[Install]
WantedBy=default.target
